      "system_prompt": "You are AURA, an Adaptive Universal Response Assistant. Keep answers clear and direct. [CONTEXT_INJECTION]"
    }
  },
  "generator": {
    "default_model": "nota-ai/bk-sdm-tiny",
    "default_size": 256,
    "default_steps": 15,
    "default_fps": 4,
    "default_frames": 8,
    "guidance_scale": 7.5,
    "output_dir": "outputs",
    "negative_prompt": "blurry, ugly, deformed, low quality, watermark, jpeg artifacts, worst quality, bad anatomy",
    "default_strength_i2i": 0.6,
    "default_strength_t2v": 1.0,
    "default_strength_i2v": 0.35
  },
  "web_search": {
    "default_browser": "default",
    "open_command": "xdg-open",
    "search_endpoints": {
