{
  "speech_to_text": {
    "energy_threshold": 200,
    "dynamic_energy_threshold": true,
    "dynamic_energy_adjustment_damping": 0.15,
    "dynamic_energy_ratio": 1.5,
    "pause_threshold": 2.5,
    "phrase_threshold": 0.3,
    "non_speaking_duration": 0.8,
    "wait_for_speech_timeout": 20,
    "max_phrase_duration": 45,
    "language": "en-IN",
    "calibration_duration": 1.5,
    "post_speech_buffer": 0.5,
    "log_timing": true
  },
  "text_to_speech": {
    "rate": 130,
    "volume": 1.0,
    "gender": "female",
    "voice_id": "english-us", 
    "espeak_variant": "f4", 
    "female_keywords": [
      "female",
      "english-us",
      "f3",
      "f4"
    ]
  },
  "assistant": {
    "chat_model": "phi4-mini:latest",
    "coder_model": "qwen2.5-coder:3b",
    "vision_model": "llava:latest",
    "coder_keywords": [
      "code",
      "python",
      "c++",
      "java",
      "bug",
      "debug",
      "leetcode",
