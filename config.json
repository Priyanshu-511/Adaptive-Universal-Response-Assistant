    "name": "AURA",
    "version": "1.0.0",
    "wake_word": null,
    "voice_always_on": true,
    "fallback_to_text_input": true,
    "speak_logs": false,
    "startup_greeting": "Hello! AURA is online. Adaptive Universal Response Assistant ready.",
